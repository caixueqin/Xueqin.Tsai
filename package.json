{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "rm -f prisma.config.ts prisma.config.js && rm -rf node_modules .prisma prisma/.prisma && npm ci --no-audit --no-fund && node db-setup.js && npx prisma --version && npx prisma generate && npx prisma db push --accept-data-loss && next build",
    "start": "node runtime-init.js && node index.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "mysql2": "^3.9.7",
    "next": "16.2.7",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "typescript": "^5"
  }
}
